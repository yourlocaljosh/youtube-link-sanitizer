# ---- Packaged extension artifacts ----
# Never commit the .pem: it is the signing key that determines your extension ID.
*.crx
*.pem
*.zip
web-ext-artifacts/

# ---- Secrets ----
# Chrome Web Store publishing credentials (client id/secret/refresh token).
.env
.env.*
!.env.example
secrets.json
*.key

# ---- Test / debug output ----
.chrome-test-profile/
.chrome-ext-profile/
*.log

# ---- Optional future tooling ----
# Kept so adding a build step or test runner later needs no .gitignore changes.
node_modules/
dist/
build/
.output/
.wxt/
.vite/
coverage/
.cache/
*.tsbuildinfo

# ---- Editors / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---- OS cruft ----
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
.DS_Store
._*
.directory
.Trash-*
