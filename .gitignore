# ---- Dependencies ----
node_modules/
.pnp
.pnp.js
.pnp.cjs
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---- Build output ----
dist/
build/
out/
# WXT build output and generated types
.output/
.wxt/
.vite/
*.tsbuildinfo

# ---- Packaged extension artifacts ----
# Never commit these: the .pem is the signing key for your extension ID,
# and the zip/crx are reproducible build outputs.
*.crx
*.pem
*.zip
!docs/**/*.zip
web-ext-artifacts/

# ---- Secrets / local config ----
# Chrome Web Store publishing creds (client id/secret/refresh token),
# API keys, signing config.
.env
.env.*
!.env.example
.env.local
.env.*.local
secrets.json
*.key

# ---- Test / coverage ----
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
.playwright/
*.lcov

# ---- Caches / tooling ----
.cache/
.temp/
.tmp/
.eslintcache
.stylelintcache
.parcel-cache/
.turbo/
.rollup.cache/
node_modules/.cache/

# ---- Editors / IDE ----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ---- OS cruft ----
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
# Linux
.directory
.Trash-*

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Browser profiles used for dev-launching ----
.chrome-profile/
.firefox-profile/
chrome-data/
